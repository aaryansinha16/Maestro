# Maestro Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# ─── Anthropic / Claude ───────────────────────────────────────────────
# Optional. Maestro primarily spawns the local `claude` CLI authenticated
# to the developer's Pro/Max subscription (see ADR-001). Set this only if
# direct API calls become necessary.
# ANTHROPIC_API_KEY=

# ─── GitHub ───────────────────────────────────────────────────────────
# Fine-grained personal access token, scoped to the developer's repos.
# Required permissions: repo (read/write), pull requests (write), issues (read).
GITHUB_TOKEN=

# ─── Telegram (daily briefings) ──────────────────────────────────────
# Created via @BotFather. Used in Phase 4.
TELEGRAM_BOT_TOKEN=
# Developer's chat id with the bot. Get via @userinfobot.
TELEGRAM_CHAT_ID=

# ─── Conductor runtime ───────────────────────────────────────────────
# Where SQLite state and per-project working directories live.
# Defaults to ./data when unset.
MAESTRO_DATA_DIR=./data

# Port the Hono server listens on. Default 3000.
MAESTRO_PORT=3000

# Hard backstop on a single session's estimated spend (USD), passed to Claude
# Code via --max-budget-usd. Default 10; set 0 to disable. Bounds a runaway
# session — normal sessions cost well under $1. Under the subscription model
# this bounds token consumption more than real dollars.
# MAESTRO_SESSION_BUDGET_USD=10

# ─── Developer identity ──────────────────────────────────────────────
# Used for git commits made by Maestro on behalf of the developer.
DEVELOPER_NAME=Aaryan Sinha
DEVELOPER_EMAIL=
DEVELOPER_GITHUB_USERNAME=aaryansinha16

# ─── Dashboard ───────────────────────────────────────────────────────
# Where the dashboard expects the conductor API. In dev this is proxied
# through Vite, so usually unset locally.
# VITE_API_BASE_URL=http://localhost:3000

# ─── Auth (Phase 5) ──────────────────────────────────────────────────
# When BOTH are set, the dashboard + API require HTTP Basic Auth
# (except /api/health, kept open for platform healthchecks). REQUIRED
# for any public deployment. Password must be ≥ 8 chars.
# MAESTRO_AUTH_USER=
# MAESTRO_AUTH_PASSWORD=

# In production (NODE_ENV=production, set by the Docker image) the conductor
# REFUSES to boot unless auth is configured above — or you explicitly opt into
# an open instance here. Leave unset for the secure default. (PROD-01)
# MAESTRO_ALLOW_UNAUTHENTICATED=true

# Optional CORS allow-origin. Leave unset (same-origin only) unless a
# separately-hosted frontend needs API access.
# MAESTRO_CORS_ORIGIN=

# ─── Briefing + housekeeping (Phase 5) ───────────────────────────────
# Daily Telegram digest time, HH:MM in MAESTRO_TZ (default 08:00).
# Requires TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID above to actually send.
# MAESTRO_BRIEFING_TIME=08:00
# Public dashboard URL used for briefing deep-link buttons.
# MAESTRO_DASHBOARD_URL=
# Session logs older than this many days are GC'd daily (default 30).
# MAESTRO_SESSION_LOG_RETENTION_DAYS=30
# Write rotating conductor logs to this dir (daily, gzip, 14 kept).
# Leave unset for stdout (dev pretty-print / platform log capture).
# MAESTRO_LOG_DIR=
